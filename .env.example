# Copy to .env (never commit .env). No secrets in this file.

# Sepolia RPC. Must support eth_simulateV1 (used from step 2 on). Used for fork tests and scripts.
SEPOLIA_RPC_URL=

# Mainnet RPC used only as the tor-js Anon-RPC bootstrap (excluded traffic, see README).
MAINNET_BOOTSTRAP_RPC_URL=

# Owner / deployer key for Sepolia setup scripts. Local only. Never commit.
OWNER_PRIVATE_KEY=

# Etherscan key for contract verification (step 1.4).
ETHERSCAN_API_KEY=
